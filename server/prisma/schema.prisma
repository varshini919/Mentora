datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  EXPERT
  ADMIN
}

enum MeetingType {
  ONLINE
  OFFLINE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  expertProfile ExpertProfile?
  bookings      Booking[]      @relation(name: "LearnerBookings")

  @@map("users")
}

model ExpertProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  bio               String             @db.Text
  yearsOfExperience Int
  company           String
  location          String
  hourlyRate        Float
  profileImage      String?            @db.Text
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  skills            ExpertSkill[]
  services          ExpertService[]
  slots             AvailabilitySlot[]
  bookings          Booking[]

  @@map("expert_profiles")
}

model Skill {
  id      String        @id @default(uuid())
  name    String        @unique
  experts ExpertSkill[]

  @@map("skills")
}

model ExpertSkill {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([expertProfileId, skillId])
  @@map("expert_skills")
}

model ExpertService {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  serviceTitle    String
  description     String        @db.Text
  duration        Int // Duration in minutes
  price           Float
  meetingType     MeetingType   @default(ONLINE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookings        Booking[]

  @@map("expert_services")
}

model AvailabilitySlot {
  id              String        @id @default(uuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String // e.g., "09:00"
  endTime         String // e.g., "10:00"
  isBooked        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking?

  @@map("availability_slots")
}

model Booking {
  id              String           @id @default(uuid())
  learnerId       String
  learner         User             @relation(name: "LearnerBookings", fields: [learnerId], references: [id], onDelete: Cascade)
  expertProfileId String
  expertProfile   ExpertProfile    @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  serviceId       String
  service         ExpertService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slotId          String?          @unique
  slot            AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  bookingDate     DateTime
  status          BookingStatus    @default(PENDING)
  meetingLink     String?
  meetingLocation String?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("bookings")
}
